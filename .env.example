# -----------------------------------------------------------------------
# Lien Automation — Environment Variables
# -----------------------------------------------------------------------
# Copy this file to .env and fill in your values before running locally.
# In Cloud Run, set these as Secret Manager secrets or env vars in the
# service configuration (NOT in the Docker image).

# Google service account credentials (full JSON, single-line)
# Service account: lien-extraction-prod@lien-extraction-sa.iam.gserviceaccount.com
# Must have "Editor" access on the target spreadsheet.
SHEETS_KEY={"type":"service_account","project_id":"lien-extraction-sa","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"lien-extraction-prod@lien-extraction-sa.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Target Google Spreadsheet ID
SHEET_ID=18C3Qrk3rEXZ9oNocIEUugFLh6q38DRw9JVwznTHoRN0

# Server port (default 8080 — matches Cloud Run expectation)
PORT=8080
